# Local development: the Next.js dev server proxies /api to this origin.
API_PROXY_TARGET=http://127.0.0.1:5000

# Production values are set in the Vercel project environment (then redeploy).
# Same-origin proxy (recommended, keeps auth cookies first-party):
# API_PROXY_TARGET=https://your-api-host.example.com
# Direct browser calls to the API (include the /api suffix):
# NEXT_PUBLIC_API_URL=https://your-api-host.example.com/api
