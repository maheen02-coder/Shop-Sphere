# Production values live in the hosting provider's environment settings.
# Never commit a real .env file.
PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shopsphere?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE=7d
CLIENT_URL=https://shop-sphere-nine-nu.vercel.app
